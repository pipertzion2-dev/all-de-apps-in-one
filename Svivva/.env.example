# ─── Core (required) ─────────────────────────────────────────
# Local: from repo root run `docker compose up -d postgres` (see ../docker-compose.yml), then use:
DATABASE_URL=postgresql://svivva:svivva_local_dev@127.0.0.1:5432/svivva

# Public site URL (no trailing slash) — Orbit, Seeds funnel, IndexNow, sitemap pings, and UI copy all derive from this.
# Production example: https://zzaizzai.com
# Local Mac browser: http://127.0.0.1:5000 is fine. On another device (phone), 127.0.0.1 is THAT device — use your Mac's LAN IP instead, e.g. http://192.168.1.10:5000 (Orbit shows a copyable hint when you open localhost).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5000

# Clutety corner ad + promo links. Default: /clutety-coming-soon (iOS not live yet).
# NEXT_PUBLIC_CLUTETY_EXTERNAL_URL=https://apps.apple.com/app/clutety/idXXXXXXXXX
# NEXT_PUBLIC_CLUTETY_MAIN_URL=https://zzaizzai.com/clutety-coming-soon
# Optional: host the Vite cybersec-app elsewhere. Default is same-origin /clutety/embed (Lock UI).
# NEXT_PUBLIC_CLUTETY_APP_URL=https://your-host.example/pyracrypt-shell
# NEXT_PUBLIC_CLUTETY_MINI_APPS_URL=https://zzaizzai.com/ai-tools-hub
# Legacy aliases still work: NEXT_PUBLIC_PYRACRYPT_MAIN_URL, NEXT_PUBLIC_PYRACRYPT_MINI_APPS_URL

# Dev server port (default 5000). macOS often reserves :5000 for AirPlay Receiver — if `npm run dev` fails with EADDRINUSE, set both:
# PORT=3000
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-to-server calls (optional). Defaults to NEXT_PUBLIC_SITE_URL, then VERCEL_URL.
# INTERNAL_APP_ORIGIN=http://127.0.0.1:5000

# Strong random string for session / crypto where applicable
NEXTAUTH_SECRET=

# ─── Poor Man Protection email delivery (optional) ────────────
# Official certificate email via Resend (https://resend.com). Without these, users can still
# download court PDF / postal pack / JSON. Attachments require a verified from-domain.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ZZAI Protection <protection@yourdomain.com>

# ─── Hosting (production: Vercel) ─────────────────────────────
# Deploy: Vercel team zzai-zzai, project all-de-apps-in-one, Root Directory = Svivva.
# Optional git: Cursor Origin (docs/ORIGIN_HOSTING.md). VERCEL_URL is injected on deploy.
# NEXT_PUBLIC_SITE_URL should be https://zzaizzai.com in production.

# ─── Svivva Play AI (Vercel) ──────────────────────────────────
# Tempo/key always works via browser DSP + music-theory engine (no key required).
# For LLM chord/section enrichment on Vercel, add ONE of these in Vercel project env:
# GEMINI_API_KEY=          ← Google AI Studio free tier (recommended)
# OPENAI_API_KEY=          ← optional paid OpenAI

# ─── OpenID (Replit Auth today) ───────────────────────────────
# On Replit, REPL_ID is injected. Elsewhere you must migrate issuer + client (see docs).
# ISSUER_URL=https://replit.com/oidc
# OIDC_CLIENT_ID=
# REPL_ID=

# Optional: store the same keys in Postgres from /dashboard/settings/runtime-keys (admin) when host env is empty.

# ─── Completing Orbit + SEO for $0 (free tiers only) ──────────
# The admin Launchpad → "Complete Orbit + SEO for $0" panel walks this in order.
# Nothing below needs a card or a trial:
#   1. Google Search Console  free       press the camo orb on Launchpad
#   2. IndexNow               free       key auto-created on first autopilot run
#   3. Bing Webmaster Tools   free       verify domain; Orbit already pings Bing
#   4. Google Gemini          free tier  GEMINI_API_KEY below (replaces OpenAI)
#   5. n8n Community          free       self-host; unlimited executions forever
#   6. Postiz                 free       self-host; social auto-posting (AGPL)
#   7. Resend                 free tier  3,000 emails/mo, 100/day
#   8. Microsoft Clarity      free       NEXT_PUBLIC_CLARITY_ID below
# Postiz + n8n keys are pasted in the Launchpad UI (stored in Postgres), not here.
# Watch out: Ayrshare has no free tier ($149/mo entry) and X/Twitter dropped its
# free API tier in Feb 2026 (~$0.015/post, $0.20 with a link). Postiz or n8n
# avoids both. Set ORBIT_COPY_ONLY=1 to generate copy without posting at all.

# ─── Orbit marketing AI (admin launchpad + autopilot) ─────────
# Orbit prefers paid OpenAI when OPENAI_API_KEY is set (sk- billing key).
# Marketing autopilot defaults to gpt-5 for best copy — override if needed:
OPENAI_API_KEY=
# Optional: force provider — openai | gemini | ollama (default: openai if sk- key exists, else gemini)
# ORBIT_AI_PROVIDER=openai
# ORBIT_AI_MODEL=gpt-5
# Copy-only mode (no auto-posting to social/email) — default when no Ayrshare/Resend/n8n keys:
# ORBIT_COPY_ONLY=1
# Free fallback when no OpenAI key:
# GEMINI_API_KEY=
# OLLAMA_URL=http://127.0.0.1:11434
# Replit AI Integrations proxy (optional alternative to OPENAI_API_KEY)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# Play scale search uses the same URL; on Vercel use a reachable host (tunnel/VPS), not localhost.

# ─── Stripe (payments + checkout + portal) ─────────────────────
# Keys: https://dashboard.stripe.com/apikeys — use the same account as before; copy Secret + Publishable into Vercel/host env (or admin → /dashboard/settings/runtime-keys).
# Webhook: https://YOUR_DOMAIN/api/stripe/webhook — if the site domain changed, add a new endpoint in Stripe (Developers → Webhooks) and paste the new signing secret as STRIPE_WEBHOOK_SECRET.
# Events: checkout.session.completed, customer.subscription.deleted
# Products: optional one-time `npm run stripe:seed` (with STRIPE_SECRET_KEY set) if Pro/Enterprise prices are missing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Client-side Elements (optional if you only use publishable-key API route)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Site owner id(s) for Orbit, Growth, marketing APIs, Traffic, GSC (Replit OIDC `sub`, Clerk id, etc.). Comma-separated = multiple admins.
# Required on production builds: if unset in NODE_ENV=production, no account is treated as admin.
# In local dev (next dev), if unset, any signed-in user is treated as admin for convenience.
# ADMIN_USER_ID=

# ─── Background jobs / automation ───────────────────────────
# Shared secret for internal API calls (SEO scheduler, growth tasks)
ORBIT_INTERNAL_SECRET=
# Optional: user_id for internal Orbit/cron when it must differ from the first `ADMIN_USER_ID`. If unset, `ADMIN_USER_ID` (first) is used, then the latest `seed_credentials` row.
# ORBIT_INTERNAL_USER_ID=

# Vercel Cron: set in Vercel project env; Vercel sends Authorization: Bearer CRON_SECRET
CRON_SECRET=

# Dev SEO scheduler interval (hours)
# SEO_AUTO_INTERVAL_HOURS=24

# Upgrade the marketing/keyword-research model once you add credits (OpenAI key
# or AI Gateway). Falls back to the provider default (gpt-4o-mini / gemini-flash).
#   e.g. gpt-5, gpt-4o, or an AI Gateway model id
# ORBIT_AI_MODEL=

# ─── Analytics (optional) ─────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GADS_ID=
# NEXT_PUBLIC_CLARITY_ID=

# ─── Google Search Console (OAuth — recommended for Orbit indexing) ──
# Create at https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: https://YOUR_DOMAIN/api/gsc/oauth/callback
# Enable APIs: Search Console API + Web Search Indexing API
# GOOGLE_GSC_CLIENT_ID=
# GOOGLE_GSC_CLIENT_SECRET=
# Google Search Console HTML tag verification (recommended for prod).
# 1. Search Console → Add property → URL prefix → https://zzaizzai.com
# 2. Choose "HTML tag" verification → copy the content= value only (not the full meta tag)
# 3. Paste below in Vercel Production env → redeploy
# Example: if the tag is <meta name="google-site-verification" content="abc123" /> use abc123
# GOOGLE_SITE_VERIFICATION=your-verification-code-here

# Sitemap submission to GSC uses a service-account JSON pasted at /dashboard/gsc-connect.
# (No env var — stored in the database, scoped to ADMIN_USER_ID for cron use.)

# ─── GoDaddy / marketing integrations (optional) ──────────────
# Set your apex domain + API keys in the dashboard: Marketing → Traffic Setup, or Orbit → Connections Hub.
# Domain must match the name registered at GoDaddy (e.g. mysite.com). Use NEXT_PUBLIC_SITE_URL so "Fill domain" works.
# API keys: https://developer.godaddy.com/keys

# ─── Linked funnel apps (replace Replit defaults after you deploy elsewhere) ─
# NEXT_PUBLIC_PYRACRYPT_MAIN_URL=https://main.yourdomain.com
# NEXT_PUBLIC_PYRACRYPT_MINI_APPS_URL=https://mini.yourdomain.com
